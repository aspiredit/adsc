{
  "$schema": "../node_modules/wrangler/config-schema.json",
  // ADSC RAG chat Worker (slice C). Deploy: `npx wrangler deploy` from worker/.
  // Account id + auth come from the OAuth session / .env — not committed here.
  "name": "adsc-chat",
  "main": "index.js",
  "compatibility_date": "2026-07-29",

  // Workers AI: embeds the question and runs the grounded LLM. Account-level
  // binding — no API key at runtime.
  "ai": { "binding": "AI" },

  // Per-IP rate limit: 15 requests/minute. namespace_id is an arbitrary local
  // id that scopes the counter to this limiter.
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 15, "period": 60 } }
  ],

  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
